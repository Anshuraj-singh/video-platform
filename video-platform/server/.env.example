NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
ALLOW_DEMO_AUTH=true
ALLOW_FILE_ORIGIN=true

MONGODB_URI=mongodb://127.0.0.1:27017/loop_platform?replicaSet=rs0
SESSION_SECRET=replace-with-a-long-random-secret
DEVICE_HASH_SECRET=replace-with-another-long-random-secret
OTP_SECRET=replace-with-a-third-long-random-secret
ALLOW_DEMO_OTP_ECHO=true

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=LOOP <receipts@example.com>
